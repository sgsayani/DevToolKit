# Required for the AI Assistant tools (Error Explainer, Code Explainer,
# Git Command Generator, SQL Generator, Regex Generator). Without this set,
# those tools show a setup notice instead of failing or faking a response.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — overrides the default model (gemini-2.5-flash) used by the AI
# Assistant tools.
GEMINI_MODEL=

# Required for Code Share (paste creation/viewing/My Pastes). Without this
# set, Code Share shows a setup notice instead of failing. A free MongoDB
# Atlas cluster works fine: https://www.mongodb.com/cloud/atlas
MONGODB_URI=

# Optional — database name to use within that MongoDB deployment. Defaults
# to "devkit".
MONGODB_DB=

# Optional — the site's production URL, used in metadata, canonical links,
# Open Graph tags, and sitemap.xml/robots.txt. Set this once you have a
# custom domain. Without it, DevKit falls back to its current Vercel
# deployment URL.
NEXT_PUBLIC_SITE_URL=

# Optional — overrides the GitHub repository URL shown in the footer, About,
# and Contact pages. Only needed if the repository ever moves.
NEXT_PUBLIC_GITHUB_URL=
